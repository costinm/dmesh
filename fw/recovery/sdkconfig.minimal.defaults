# Minimal Recovery profile: open STA client with one raw TCP connection.
# The infrastructure node provides the AP; Recovery does not provide one.

CONFIG_LWIP_MAX_SOCKETS=1
# The flash sender must be able to pipeline several 4 KiB DRS2 blocks without
# an application ACK for every block. These are normal lwIP TCP buffers, not a
# second acknowledgement protocol. A 64 KiB window is bounded for Recovery's
# roughly 300 KiB free heap and avoids collapsing after only a few frames on a
# direct-AP link. The mailbox size follows the ESP-IDF recommendation of
# TCP_WND/TCP_MSS + 2.
CONFIG_LWIP_SO_RCVBUF=y
# Advertise a full Ethernet/Wi-Fi MSS. Leaving this to the SDK's conservative
# default (536) turns every 4 KiB block into many small TCP segments and made
# the direct AP transfer appear to stall even with a large receive window.
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_TMR_INTERVAL=20
CONFIG_LWIP_TCP_RECVMBOX_SIZE=48
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# Enable native lwIP TCP selective acknowledgements. This is TCP loss
# recovery, not a DRS2 block-ack protocol: when Wi-Fi reorders or drops
# segments, the host can retransmit only the missing segments.
CONFIG_LWIP_TCP_SACK_OUT=y
# Keep the SDK's bounded no-PSRAM out-of-order queue. Larger values require
# the PSRAM-backed lwIP profile and are rejected by ESP-IDF for this board.
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=12
# Wi-Fi runs on CPU0; keep TCP/IP and the flash worker together on CPU1 so
# receive-window updates do not migrate between cores during a transfer.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
# Keep enough Wi-Fi and lwIP RX storage for a full receive window. The
# default RX/BA values are tuned for small interactive sockets and allow the
# direct-AP sender to outrun Recovery until out-of-order buffers are full.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# CONFIG_LWIP_IPV6 is not set
# CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES is not set
# CONFIG_LWIP_DHCPS is not set

# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_DPP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_WPS_SOFTAP_REGISTRAR is not set
# CONFIG_ESP_WIFI_WPS_STRICT is not set
# CONFIG_ESP_WIFI_WPS_PASSPHRASE is not set
# CONFIG_ESP_WIFI_NAN_ENABLE is not set
CONFIG_ESP_WIFI_MBEDTLS_CRYPTO=y
# CONFIG_ESP_WIFI_NVS_ENABLED is not set

# No application TLS or certificate bundle in the bootstrap image.  The Wi-Fi
# dependency graph may still retain the SDK's certificate/RSA support.
CONFIG_MBEDTLS_TLS_DISABLED=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set
# ESP-IDF 6's Wi-Fi dependency graph still compiles certificate-aware TLS
# support even though Recovery does not initiate TLS.  Keep the SDK-required
# RSA backend enabled; Recovery itself verifies direct P-256 signatures.
CONFIG_MBEDTLS_RSA_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECP_C=y
# CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED is not set
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
# CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED is not set
# CONFIG_MBEDTLS_CURVE25519_C is not set
# CONFIG_MBEDTLS_SHA512_C is not set
# Use the ESP32 SHA accelerator for the per-block DRS2 digest. Wi-Fi's MbedTLS
# crypto adapter is enabled above because the WPA SHA-1 glue otherwise remains
# unresolved when hardware SHA is selected.
CONFIG_MBEDTLS_HARDWARE_SHA=y
# CONFIG_MBEDTLS_SHA1_C is not set
CONFIG_MBEDTLS_SHA256_C=y
# ESP-IDF's baseline MbedTLS port hard-defines AES/CTR-DRBG support even when
# Wi-Fi MbedTLS integration is disabled. Keep the AES module for that ABI;
# TLS, certificates, asymmetric curves, and general-purpose public-key APIs
# remain disabled.
CONFIG_MBEDTLS_AES_C=y
# CONFIG_MBEDTLS_CCM_C is not set
# CONFIG_MBEDTLS_GCM_C is not set

# Ship the minimal Recovery image without debug optimization, assertions, or
# runtime logging.  Recovery reports protocol errors to its bounded control
# path; normal operation has no serial log dependency.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
# Keep the minimal image quiet during normal operation while retaining the
# warnings/errors needed to diagnose an AP or negotiated-flash failure.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
