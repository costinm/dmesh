CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# The C6 test board is reliable at 40 MHz; keep the bootloader and app image
# contract below the marginal 80 MHz setting seen during early flash reads.
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHFREQ="40m"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BOOTLOADER_RESERVE_RTC_MEM=y
CONFIG_BOOTLOADER_RESERVE_RTC_SIZE=0x20
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC=y
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_SIZE=0x20
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
# The C6 inventory device exposes USB-Serial/JTAG rather than a USB-UART
# bridge.  Keep the stage2 console and selector on that same CDC stream.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
